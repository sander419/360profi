[Unit]
Description=Бэкап базы 360PROFI
After=360profi-api.service

[Service]
Type=oneshot
User=profi360
Group=profi360
Environment=DB_PATH=/var/lib/360profi/360profi.db
Environment=BACKUP_DIR=/var/backups/360profi
Environment=KEEP_DAYS=30
ExecStart=/opt/360profi/deploy/backup.sh
ReadWritePaths=/var/backups/360profi /var/lib/360profi
SyslogIdentifier=360profi-backup
